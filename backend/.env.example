PORT=5000
DATABASE_URL="postgresql://user:password@localhost:5432/mausam?schema=public"
JWT_SECRET="your_jwt_secret_key"

# Optional: Google Gemini Free API key (from https://aistudio.google.com/app/apikey)
# If omitted, Mausam automatically uses the built-in local knowledge engine fallback.
GEMINI_API_KEY="your_free_gemini_api_key"

